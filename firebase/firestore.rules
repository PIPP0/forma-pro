rules_version = '2';
// Forma Pro: resultados de pruebas en la nube.
// - Cada estudio pertenece a la cuenta que lo publicó (la del navegador de quien diseña, anónima o con correo).
// - Participantes anónimos solo pueden crear y actualizar SU sesión, y solo en estudios abiertos.
// - Solo la persona dueña del estudio puede leer o borrar las sesiones.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function studyData(id) { return get(/databases/$(database)/documents/studies/$(id)).data; }

    // Copia congelada del prototipo para el enlace corto: se abre con el id (como el enlace largo), no se puede listar.
    match /publicStudies/{studyId} {
      allow get: if true;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /studies/{studyId} {
      allow read, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;

      match /sessions/{sessionId} {
        allow read, delete: if signedIn() && studyData(studyId).ownerUid == request.auth.uid;
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/studies/$(studyId))
          && studyData(studyId).status == 'open'
          && request.resource.data.participantUid == request.auth.uid;
        allow update: if signedIn()
          && resource.data.participantUid == request.auth.uid
          && request.resource.data.participantUid == request.auth.uid;
      }
    }
  }
}
